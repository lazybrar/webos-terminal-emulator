#!/bin/sh
# Start wlterm2 detached (runs as root on the TV). Extra arguments are passed to wlterm2.
# - wlterm2 is looked up next to this script (the installed app), then in /media/developer/bin.
# - Fira Code is downloaded on first run; if that fails the TV's DroidSansMono is used so the terminal still opens.
# - If one is already running its window is hidden behind the launcher card and cannot be re-shown, so it is closed
#   (clean quit, then kill) and replaced by a fresh one.
here=$(cd "$(dirname "$0")" && pwd)
bin=$here/wlterm2; [ -x "$bin" ] || bin=/media/developer/bin/wlterm2
export XDG_RUNTIME_DIR=/tmp/xdg
log=/tmp/wlterm2.log
conf=${WLTERM_CONF:-/media/developer/wlterm.conf}

fonts=/media/developer/fonts; reg=$fonts/FiraCode-Regular.ttf
extra=
if [ ! -f "$reg" ] && ! grep -q '^[[:space:]]*font[[:space:]]*=' "$conf" 2>/dev/null; then
  mkdir -p "$fonts"
  ( cd "$fonts" && curl -sSfL --max-time 90 -o f.zip https://github.com/tonsky/FiraCode/releases/download/6.2/Fira_Code_v6.2.zip \
      && unzip -o -q -j f.zip ttf/FiraCode-Regular.ttf ttf/FiraCode-Bold.ttf; rm -f f.zip ) >"$log" 2>&1
  [ -f "$reg" ] || extra="-f /usr/share/fonts/DroidSansMono.ttf"
fi

if pidof wlterm2 >/dev/null 2>&1; then
  echo quit > /tmp/wlterm2.ctl 2>/dev/null
  i=0; while pidof wlterm2 >/dev/null 2>&1 && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
  pidof wlterm2 >/dev/null 2>&1 && { kill -9 $(pidof wlterm2); sleep 0.3; }
fi
# $extra first so explicit arguments win
setsid "$bin" $extra "$@" </dev/null >>"$log" 2>&1 &
exit 0
